# Copy to .env locally. Names only — never commit real values.
# Compose Postgres password contentforge/contentforge is local-dev only.
DATABASE_URL=
REDIS_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
JWT_SECRET=
PUBLIC_API_URL=
PUBLIC_WEB_URL=
# Leave empty on VPS (direct to api.telegram.org). Set locally if api.telegram.org is blocked in RU.
# HTTP CONNECT: http://127.0.0.1:7890  |  ssh -D / SOCKS5: socks5h://127.0.0.1:12335
# socks5/socks5h requires httpx[socks] (already in requirements).
# TELEGRAM_HTTPS_PROXY=
#
# Instagram Graph — фаза 2, после VPS. Не коммитить. META_APP_SECRET и ACCESS_TOKEN не в чат.
# Product path: POST /api/v1/brands/{id}/channels/instagram/credentials
#   { pdn_consent, access_token, ig_user_id } → Fernet on ChannelAccount (not these env vars).
# META_APP_ID=
# META_APP_SECRET=
# Production (kitchen.alexklyvibe.ru):
# POSTGRES_PASSWORD=
# PUBLIC_API_URL=https://kitchen.alexklyvibe.ru
# PUBLIC_WEB_URL=https://kitchen.alexklyvibe.ru
# Meta Valid OAuth Redirect URI:
# https://kitchen.alexklyvibe.ru/api/v1/channels/oauth/callback
